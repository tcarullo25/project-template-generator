<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>{{ProjectNamespace}}.Api</RootNamespace>
    <AssemblyName>{{ProjectNamespace}}.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\{{ProjectName}}.Application\{{ProjectName}}.Application.csproj" />
    <ProjectReference Include="..\{{ProjectName}}.Infrastructure\{{ProjectName}}.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenAPI document + UI for the REST API during development. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="{{SwashbuckleVersion}}" />
    <!-- Required by 'dotnet ef' to build the design-time model. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="{{EfCoreVersion}}">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="{{ProjectNamespace}}.Api.Tests" />
  </ItemGroup>

</Project>
