{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port={{PostgresPort}};Database={{DatabaseName}};Username={{DatabaseUser}};Password=change-me-locally"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:{{WebDevPort}}"
    ]
  }
}
